body[data-type="music"]
  background #e2d2d2
  #body-wrap
    justify-content: flex-start;
  #center-console + label i
    background: var(--anzhiyu-white) !important
  .layout
    flex-direction: row;
  #page
    border 0
    box-shadow none !important
    padding 0 !important
    background transparent !important
    .page-title
      display: none
  #page-header
    #nav
      backdrop-filter none !important
      background 0 0 !important
      border-bottom none !important
      a, .back-home-button
        color var(--anzhiyu-white) !important
      #center-console + label i
        background var(--anzhiyu-white) !important
      .menus_items
        .menus_item 
          .menus_item_child 
            li
              background pink

  #footer, #nav-music
    display none
  #an_music_bg
    display block
  #web_bg
    display none
  .s-sticker
    div
      color var(--anzhiyu-white) !important
  #console
    .button-group 
      .console-btn-item 
        a
          background pink
  #center-console:checked + label::after
    background pink !important

[data-theme="dark"]
  body[data-type="music"]
    background #0d0d0d
    .page
      #page-header
        &:before
          background-color transparent
        #nav
          .menus_items
            .menus_item 
              .menus_item_child 
                li
                  background transparent


#an_music_bg
  display none
  filter blur(63px)
  opacity 0.6
  position fixed
  z-index -999
  background-attachment local
  background-position center center
  background-size cover
  background-repeat no-repeat
  width 200%
  height 200%
  top -50%
  left -50%
  transform rotate(0deg)
  transition .3s

if hexo-config('nav_music.console_widescreen_music') == false
  body
    &:has(#console.show)
      #nav-music
        display: none !important
if hexo-config('nav_music.enable') == false
  #nav-musicanMusicSwitching
    display: none !important
  body
    &:has(#console.show)
      #nav-music
        display: flex !important;

@media screen and (max-width: 1400px)
  body[data-type="music"]
  #anMusic-page
    #anMusicSwitching, #anMusicRefreshBtn, #anMusicBtnGetSong
      right .7vw
      width 35px
      height 35px
    #anMusicSwitching
      bottom: 186px
    #anMusicRefreshBtn
      bottom: 267px
    #anMusicBtnGetSong
      bottom: 227px


#anMusic-page
  #anMusicRefreshBtn, #anMusicBtnGetSong, #anMusicSwitching
    position: fixed;
    display: flex;
    width: 50px;
    height: 50px;
    bottom: 100px;
    padding: 5px;
    background: var(--anzhiyu-white-op);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-radius: 50%;
    color: #fff;
    text-align: center;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    z-index 2
  #anMusicBtnGetSong
    right: 3.5vw;
  #anMusicRefreshBtn
    right: 3.5vw;
    bottom: 220px;
  #anMusicSwitching
    right: 3.5vw;
    bottom: 160px;
  +maxWidth768()
    #anMusicRefreshBtn, #anMusicBtnGetSong, #anMusicSwitching
      width: 35px;
      height: 35px;
      opacity: .7;
    div#anMusicBtnGetSong
      right: 21px;
      bottom: 191px;
    div#anMusicRefreshBtn
      right: 21px;
      bottom: 231px;
    div#anMusicSwitching
      right: 21px;
      bottom: 150px;
  meting-js
    .aplayer
      display flex
      flex-direction row-reverse
      background rgba(0, 0, 0, 0)
      border none
      box-shadow none
      .aplayer-body
        width 40%
        height calc(100vh - 169px)
        .aplayer-pic
          float none
          width 180px
          height 180px
          border-radius 12px
          margin auto
          left 0
          right 0
          transition: background-image 0.5s ease-in-out;
          background-size: cover;
          background-color: transparent !important;
        .aplayer-info
          margin 0 20px 0 20px
          border-bottom none
          .aplayer-music
            text-align center
            height auto
            margin 15px
            .aplayer-author, .aplayer-title
              font-size 2rem
              font-weight 700
              color #fff
            .aplayer-title
              display block
              max-width 100%
              white-space nowrap
              overflow hidden
              text-overflow clip
              vertical-align bottom
              &.miao-scroll
                animation miaoTitleScroll 7s ease-in-out infinite alternate
            .aplayer-author
              display block
              margin-top 6px

          .aplayer-lrc
            height 800%
            margin-top 10px
            mask-image linear-gradient(to bottom, #000, #000, #000, #000, #000, #000, #000, #000, #000, #000, #0000, #0000)
            p
              font-size 20px
              line-height: 20px !important;
              height: 20px !important;
              margin: 20px 0 !important;
              color #fff
              &.aplayer-lrc-current {
                min-height: 20px;
              }
            &::after, &::before
              display none
          .aplayer-controller 
            position fixed
            max-width 1500px
            margin auto
            left 0
            right 0
            bottom 50px
            .aplayer-bar-wrap 
              margin 0 160px 0 150px
              .aplayer-bar
                height: 6px;
                border-radius: 4px;
                .aplayer-played
                  height: 6px;
                  border-radius: 4px;
                  background var(--anzhiyu-white) !important
                  .aplayer-thumb
                    width 20px
                    height 20px
                    margin-top: -7px
                    transform none
                    background #fff !important
                .aplayer-loaded
                  height: 6px;
                  border-radius: 4px;
            .aplayer-time
              position absolute
              width 100%
              bottom 21px
              height 0
              display flex
              justify-content flex-end
              .aplayer-volume-wrap
                .aplayer-volume-bar-wrap
                  bottom: 0;
                  right: -5px;
              .aplayer-icon
                width 2rem
                height 2rem
                margin-left 15px
                path
                  fill var(--anzhiyu-white)
                  opacity 0.8
                &.aplayer-icon-loop
                  margin-right 15px
              .aplayer-time-inner
                margin-right 18px
                margin-top -8px
                color white
              .aplayer-icon-back
                position absolute
                left 0
                display inline
              .aplayer-icon-play
                position absolute
                left 40px
                display inline
              .aplayer-icon-forward
                position absolute
                left 80px
                display inline
              .aplayer-icon-menu
                display none

      .aplayer-list
          width 60%
          height 100%
        ol
          padding-right 25px
          & > li
            border-top 1px solid transparent
            font-size 14px
            display flex
            &:hover
              background #ffe1e4d6
              border-radius 6px
            &.aplayer-list-light
              background #ffe1e4b3
              border-radius 6px
              padding 20px 15px
              span.aplayer-list-title
                font-weight: bolder;
              .aplayer-list-cur
                display none
            span
              color white
              &.aplayer-list-title
                  width auto
                  max-width 55%
                  overflow hidden
                  display -webkit-inline-box
                  -webkit-line-clamp 1
                  -webkit-box-orient vertical
              &.aplayer-list-author
                opacity 0.8
                position absolute
                right 10px
                width auto
                max-width 35%
                display -webkit-inline-box
                -webkit-line-clamp 1
                overflow hidden
                -webkit-box-orient vertical


@media screen and (max-width: 768px)
  body[data-type="music"]
    #rightside
      display none
    #content-inner,#page
      z-index auto
    #page-header
      #nav
        #site-name
          color var(--anzhiyu-white) !important
  #anMusic-page
    .aplayer-info .aplayer-music
      .aplayer-title
        font-size 1.3rem
        max-width 100%
        display block
      .aplayer-author
        font-size 0.78rem
        display block
        margin-top 3px
        opacity 0.86
    meting-js 
      .aplayer
        .aplayer-list
          position fixed
          z-index 1002
          width 100%
          bottom -88%
          left 0
          background var(--sidebar-bg)
          height auto
          border-radius 15px 15px 0px 0px
          padding 15px 0px
          &.aplayer-list-hide
            bottom 0% !important
          ol
            max-height 60vh !important
            padding-right 0px
            & > li
              display flex
              margin 0 10px
              span
                color var(--font-color)
                &.aplayer-list-title
                  width 30%
                  max-width 55%
                  width auto
                  display -webkit-box
                  -webkit-line-clamp 1
                  overflow hidden
                  -webkit-box-orient vertical
                &.aplayer-list-author
                  position absolute
                  right 10px
                  width auto
                  max-width 35%
                  display -webkit-box
                  -webkit-line-clamp 1
                  overflow hidden
                  -webkit-box-orient vertical
              &.aplayer-list-light
                background #ffe1e4b3
                padding 5px 20px
                border-radius 10px
                span
                  color #fff
                  &.aplayer-list-author
                    right 15px
        .aplayer-body
          width 100%
          position fixed
          left 0
          right 0
          top 86px
          bottom 0
          height auto
          display flex
          flex-direction column
          /* ① 封面：缩小到 132，居中 */
          .aplayer-pic
            position static
            float none
            flex 0 0 auto
            width 132px
            height 132px
            margin 0 auto
            border-radius 14px
            transition background-image 0.4s ease
            background-size cover
            background-color transparent !important
          .aplayer-info
            flex 1 1 auto
            display flex
            flex-direction column
            min-height 0
            margin 0 18px
            border-bottom none
            height auto
            /* ② 标题 + 歌手：一块，居中 */
            .aplayer-music
              flex 0 0 auto
              text-align center
              margin 14px 0 0
              height auto
              .aplayer-title
                display block
                max-width 100%
                font-size 1.12rem
                font-weight 700
                line-height 1.4
                white-space nowrap
                overflow hidden
                &.miao-scroll
                  animation miaoTitleScroll 7s ease-in-out infinite alternate
              .aplayer-author
                display block
                margin-top 3px
                font-size 0.74rem
                opacity 0.72
            /* ③ 歌词：中间一块，高度约 10 行；滚动交给 APlayer 自己算（它会把当前句居中） */
            .aplayer-lrc
              flex 1 1 auto
              position relative
              height auto
              max-height 42vh
              min-height 0
              margin-top 8px
              overflow hidden
              mask-image linear-gradient(to bottom, #0000, #000 16%, #000 84%, #0000)
              .aplayer-lrc-contents
                width 100%
              p.miao-lrc-credit
                visibility hidden !important
              p
                font-size 15px
                line-height 26px !important
                height auto !important
                margin 0 !important
                color var(--font-color)
                opacity 0.4
                white-space nowrap
                overflow hidden
                text-overflow ellipsis
                &.aplayer-lrc-current
                  color var(--anzhiyu-main) !important
                  opacity 1
                  font-weight 700
                  font-size 17px
                  min-height 26px
            /* ④ 控制栏：底部一块 */
            .aplayer-controller
              flex 0 0 auto
              position static
              width 100%
              margin-top auto
              padding 4px 0 24px
              .aplayer-bar-wrap
                margin 0 14px
                .aplayer-bar
                  height 5px
                  border-radius 4px
              .aplayer-volume-wrap
                display none
              .aplayer-time
                position static
                display flex
                align-items center
                justify-content space-between
                height 38px
                margin 2px 14px 0
                padding 0
                bottom auto
                .aplayer-time-inner
                  position static
                  display flex
                  gap 3px
                  margin 0
                  width auto
                  .aplayer-ptime, .aplayer-dtime
                    position static
                    right auto
                    left auto
                    margin 0
                    font-size 11px
                    opacity 0.7
                .aplayer-icon
                  position static !important
                  float none
                  margin 0 !important
                  width 24px
                  height 24px
                  left auto
                  right auto
                  top auto
                  padding 0
                .aplayer-icon-play
                  width 34px
                  height 34px
                .aplayer-icon-back
                  margin-left auto !important
                .aplayer-icon-forward
                  margin-right auto !important
                .aplayer-icon-order,
                .aplayer-icon-loop,
                .aplayer-icon-menu,
                .aplayer-icon-volume,
                .aplayer-icon-lrc
                  display none !important

  /* 三颗浮按钮：挪到封面右侧竖排，不再压在歌词上 */
  #anMusic-page
    #anMusicSwitching, #anMusicRefreshBtn, #anMusicBtnGetSong
      position fixed
      right 12px
      width 30px
      height 30px
      padding 0
      bottom auto
      z-index 1003
      background var(--anzhiyu-white-op)
      backdrop-filter saturate(180%) blur(20px)
      -webkit-backdrop-filter blur(20px)
      border-radius 50%
      display flex
      align-items center
      justify-content center
      i
        font-size 14px
    #anMusicBtnGetSong
      top 104px
    #anMusicRefreshBtn
      top 140px
    #anMusicSwitching
      top 176px

@keyframes miaoTitleScroll
  from
    transform translateX(0)
  to
    transform translateX(var(--miao-shift, -50%))

// 歌词里的署名行（作曲/编曲/混音/吉他…）不显示 —— 全局，不限断点
.aplayer-lrc-contents p.miao-lrc-credit
  visibility hidden !important
