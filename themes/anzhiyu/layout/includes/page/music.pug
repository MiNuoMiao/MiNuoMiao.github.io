#anMusic-page
  #anMusicBtnGetSong(title="随机兮爷歌曲，打开异世界的大梦")
    i(class="anzhiyufont anzhiyu-icon-shuffle")
  #anMusicRefreshBtn(title="立即刷新最新歌单")
    i(class="anzhiyufont anzhiyu-icon-arrows-rotate")
  #anMusicSwitching(title="切换歌单")
    i(class="anzhiyufont anzhiyu-icon-repeat")
  #anMusic-page-meting

script.
  (function () {
    function apply(t) {
      var cur = (t.textContent || '').trim();
      t.classList.remove('miao-scroll');
      t.style.removeProperty('--miao-shift');
      t.style.removeProperty('--miao-dur');
      t.style.removeProperty('font-size');
      t.style.removeProperty('white-space');
      t.style.removeProperty('line-height');
      t.style.removeProperty('overflow');
      t.style.removeProperty('overflow-wrap');
      if (!cur) return;
      requestAnimationFrame(function () {
        // 不滚动、不截断：放不下就把字号往下缩（最小 18px）。
        // 之前那套 marquee 是把 .aplayer-title 整个元素平移（它自己就是外框），
        // 看着像"整块在动"，而且任何一帧两头都被硬切。
        var base = parseFloat(getComputedStyle(t).fontSize) || 32;
        var cw = t.clientWidth, sw = t.scrollWidth;
        if (!cw || sw <= cw + 1) return;
        var fs = Math.max(18, Math.floor(base * cw / sw));
        t.style.setProperty('font-size', fs + 'px', 'important');
        // 线性估算偶尔差 1~2px，再校正几次（最多 6 轮，避免死循环）
        var guard = 0;
        while (fs > 18 && t.scrollWidth > t.clientWidth + 1 && guard++ < 6) {
          fs -= 1;
          t.style.setProperty('font-size', fs + 'px', 'important');
        }
        // 缩到 18px 还放不下（那种五六十字的 B 站式标题）：允许换行，
        // 让字完整待在框里，而不是被 overflow:hidden 一刀切掉。
        if (t.scrollWidth > t.clientWidth + 1) {
          t.style.setProperty('white-space', 'normal', 'important');
          t.style.setProperty('line-height', '24px', 'important');
          t.style.setProperty('overflow', 'visible', 'important');
          t.style.setProperty('overflow-wrap', 'anywhere', 'important');
        }
      });
    }
    function start() {
      var t = document.querySelector('#anMusic-page .aplayer-title');
      if (!t) { setTimeout(start, 400); return; }
      apply(t);
      try {
        new MutationObserver(function () { apply(t); })
          .observe(t, { childList: true, characterData: true, subtree: true });
      } catch (e) {}
      window.addEventListener('resize', function () { apply(t); });
    }
    // 歌手行前面那个「- 」是 APlayer 模板自带的前缀，去掉它
    function cleanAuthor() {
      var a = document.querySelector('#anMusic-page .aplayer-author');
      if (!a) return;
      var raw = a.textContent || '';
      var fixed = raw.replace(/^\s*[-–—]\s*/, '');
      if (fixed !== raw) a.textContent = fixed;
    }
    function watchAuthor() {
      var a = document.querySelector('#anMusic-page .aplayer-author');
      if (!a) { setTimeout(watchAuthor, 500); return; }
      cleanAuthor();
      try {
        new MutationObserver(cleanAuthor)
          .observe(a, { childList: true, characterData: true, subtree: true });
      } catch (e) {}
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watchAuthor);
    else watchAuthor();
  })();
