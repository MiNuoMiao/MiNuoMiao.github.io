#anMusic-page
  #anMusicBtnGetSong(title="随机兮爷歌曲，打开异世界的大梦")
    i(class="anzhiyufont anzhiyu-icon-shuffle")
  #anMusicRefreshBtn(title="立即刷新最新歌单")
    i(class="anzhiyufont anzhiyu-icon-arrows-rotate")
  #anMusicSwitching(title="切换歌单")
    i(class="anzhiyufont anzhiyu-icon-repeat")
  #anMusic-page-meting

script.
  (function () {
    // 标题 / 歌手：单行不换行。放得下就静态显示；放不下就复制成双份，
    // 轨道向左平移 -50% 无缝循环，文字从右侧重新进入。
    function build(el) {
      el.classList.remove('miao-mq-on');
      ['font-size', 'white-space', 'line-height', 'overflow', 'overflow-wrap'].forEach(function (p) {
        el.style.removeProperty(p);
      });
      el.innerHTML = '';
      var copy = document.createElement('span');
      copy.className = 'miao-mq-copy';
      var gap = document.createElement('span');
      gap.className = 'miao-mq-gap';
      var copy2 = copy.cloneNode(false);
      copy2.setAttribute('aria-hidden', 'true');
      var gap2 = gap.cloneNode(false);
      var track = document.createElement('span');
      track.className = 'miao-mq-track';
      track.appendChild(copy);
      track.appendChild(gap);
      track.appendChild(copy2);
      track.appendChild(gap2);
      el.appendChild(track);
      return { track: track, copy: copy, copy2: copy2, gap: gap, gap2: gap2 };
    }

    function measure(el, parts) {
      requestAnimationFrame(function () {
        var cw = el.clientWidth;
        var copyW = parts.copy.scrollWidth;
        if (!cw || copyW <= cw + 1) {
          // 放得下：只留一份，不滚动
          parts.copy2.style.display = 'none';
          parts.gap.style.display = 'none';
          parts.gap2.style.display = 'none';
          parts.track.classList.remove('is-on');
          return;
        }
        // 速度约 35px/s，保底 6s；双份 + 双侧等距间隔，-50% 正好接上
        parts.track.style.animationDuration = Math.max(6, copyW / 35) + 's';
        parts.track.classList.add('is-on');
      });
    }

    function apply(el, stripPrefix) {
      if (!el) return;
      var track = el.querySelector('.miao-mq-track');
      var text;
      if (track) {
        // 已挂轨道：文本以缓存为准（现在 textContent 是双份拼接，不能拿来比）
        text = el.dataset.mqText || '';
      } else {
        text = (el.textContent || '').trim();
        if (stripPrefix) text = text.replace(/^\s*[-–—]\s*/, '');
      }
      // 文本没变就不重建 DOM，避免 innerHTML 改动再次触发观察器重入循环
      if (track && el.dataset.mqText === text) {
        var copies = el.querySelectorAll('.miao-mq-copy');
        var gaps = el.querySelectorAll('.miao-mq-gap');
        measure(el, { track: track, copy: copies[0], copy2: copies[1], gap: gaps[0], gap2: gaps[1] });
        return;
      }
      el.dataset.mqText = text;
      var parts = build(el);
      parts.copy.textContent = text;
      parts.copy2.textContent = text;
      if (!text) return;
      measure(el, parts);
    }

    function watch(selector, stripPrefix) {
      var el = document.querySelector(selector);
      if (!el) { setTimeout(function () { watch(selector, stripPrefix); }, 400); return; }
      apply(el, stripPrefix);
      try {
        new MutationObserver(function () { apply(el, stripPrefix); })
          .observe(el, { childList: true, characterData: true, subtree: true });
      } catch (e) {}
      window.addEventListener('resize', function () { apply(el, stripPrefix); });
    }

    function start() {
      watch('#anMusic-page .aplayer-title', false);
      watch('#anMusic-page .aplayer-author', true);
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
  })();
