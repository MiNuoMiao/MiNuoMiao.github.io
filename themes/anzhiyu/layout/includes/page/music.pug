#anMusic-page
  #anMusicBtnGetSong(title="随机兮爷歌曲，打开异世界的大梦")
    i(class="anzhiyufont anzhiyu-icon-shuffle")
  #anMusicRefreshBtn(title="立即刷新最新歌单")
    i(class="anzhiyufont anzhiyu-icon-arrows-rotate")
  #anMusicSwitching(title="切换歌单")
    i(class="anzhiyufont anzhiyu-icon-repeat")
  #anMusic-page-meting

script.
  (function () {
    function apply(t) {
      var cur = (t.textContent || '').trim();
      t.classList.remove('miao-scroll');
      t.style.removeProperty('--miao-shift');
      t.style.removeProperty('--miao-dur');
      if (!cur) return;
      requestAnimationFrame(function () {
        var over = t.scrollWidth - t.clientWidth;
        if (over > 6) {
          t.style.setProperty('--miao-shift', '-' + (over + 48) + 'px');
          // 溢出越多，滚得越从容一点；太短就按最短时长
          var dur = Math.max(8, Math.min(20, 6 + over / 40));
          t.style.setProperty('--miao-dur', dur.toFixed(1) + 's');
          t.classList.add('miao-scroll');
        }
      });
    }
    function start() {
      var t = document.querySelector('#anMusic-page .aplayer-title');
      if (!t) { setTimeout(start, 400); return; }
      apply(t);
      try {
        new MutationObserver(function () { apply(t); })
          .observe(t, { childList: true, characterData: true, subtree: true });
      } catch (e) {}
      window.addEventListener('resize', function () { apply(t); });
    }
    // 歌手行前面那个「- 」是 APlayer 模板自带的前缀，去掉它
    function cleanAuthor() {
      var a = document.querySelector('#anMusic-page .aplayer-author');
      if (!a) return;
      var raw = a.textContent || '';
      var fixed = raw.replace(/^\s*[-–—]\s*/, '');
      if (fixed !== raw) a.textContent = fixed;
    }
    function watchAuthor() {
      var a = document.querySelector('#anMusic-page .aplayer-author');
      if (!a) { setTimeout(watchAuthor, 500); return; }
      cleanAuthor();
      try {
        new MutationObserver(cleanAuthor)
          .observe(a, { childList: true, characterData: true, subtree: true });
      } catch (e) {}
    }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', start);
    else start();
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', watchAuthor);
    else watchAuthor();
  })();
