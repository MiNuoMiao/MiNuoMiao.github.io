- loading_img = theme.preloader.avatar
#loading-box(onclick='document.getElementById("loading-box").classList.add("loaded")')
  .cat__scene
    .cat__main
      img.loading-img(alt="加载头像" class='nolazyload' src=url_for(loading_img))     
      .loading-image-dot
      .cat__body
      .cat__tail
      .cat__head
script.
  // 首屏就把浮层藏起来（不等外部脚本，避免时机问题）
  document.documentElement.classList.add('float-hidden')

  // 每次打开都从最顶上开始（别让浏览器恢复到上次的滚动位置）
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual'
  window.scrollTo(0, 0)

  const preloader = {
    endLoading: () => {
      document.getElementById('loading-box').classList.add("loaded");
      document.documentElement.style.overflow = '';
      document.body.style.overflow = '';
    },
    initLoading: () => {
      document.getElementById('loading-box').classList.remove("loaded")
    }
  }

  // 加载页期间锁住滚动（直接改内联样式，不依赖 :has）
  document.documentElement.style.overflow = 'hidden'
  document.body.style.overflow = 'hidden'

  // 消失时机：进度条走完就进页面（不等所有外链图片），4 秒兜底
  var finished = false
  function finishLoading () {
    if (finished) return
    finished = true
    preloader.endLoading()
    // 进度条也一起收掉，不然会挂在顶部停在半路
    try {
      if (window.Pace && typeof window.Pace.stop === 'function') window.Pace.stop()
      var paceEl = document.querySelector('.pace')
      if (paceEl) paceEl.style.display = 'none'
    } catch (e) {}
  }

  setTimeout(function () {
    if (window.Pace && typeof window.Pace.on === 'function') {
      if (window.Pace.running === false) {
        finishLoading()                      // 进度条已经跑完了
      } else {
        window.Pace.on('done', finishLoading)
      }
    } else {
      window.addEventListener('load', finishLoading)   // 没 pace 就退回 load
    }
  }, 150)
  setTimeout(finishLoading, 4000)

  if (!{theme.pjax && theme.pjax.enable}) {
    document.addEventListener('pjax:send', () => { preloader.initLoading() })
    document.addEventListener('pjax:complete', () => { preloader.endLoading() })
  }
